# Copiar para .env.local na raiz do rent_finder_front.
# Na Vercel: Settings → Environment Variables → DATABASE_URL (Production + Preview).
# Sem DATABASE_URL na Vercel, a home mostra instruções em vez de erro 500 opaco.

# Supabase Postgres — em produção/serverless (Vercel) prefere o pooler transaction (6543).
# Direto 5432 pode falhar por rede/DNS; ver Dashboard Supabase → Connect → Transaction pooler.
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
