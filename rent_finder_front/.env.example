# Copiar para .env.local na raiz do rent_finder_front.
# Na Vercel: Settings → Environment Variables → DATABASE_URL (Production + Preview).
# Sem DATABASE_URL, a home mostra instruções em vez de erro 500 opaco.

# Supabase Cloud — pooler transaction (porta 6543) ou conexão direta (5432).
# Dashboard: https://supabase.com/dashboard/project/gcdgjonmuyhbklbgdetx → Connect.
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.gcdgjonmuyhbklbgdetx.supabase.co:5432/postgres"

# --- Painel admin (produção) ---
# ADMIN_SESSION_SECRET="gere_com: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
# ADMIN_ROOT_USERNAME="admin"
# ADMIN_ROOT_PASSWORD="senha_forte"
# Cookie Secure só com HTTPS (nginx + SSL). Omita ou false para HTTP.
# ADMIN_COOKIE_SECURE=false

# --- Scraper OLX (opcional; útil em VPS bloqueado pela OLX) ---
# Proxy residencial: OLX_SCRAPE_PROXY="http://user:pass@host:port"
# Desativar fallback Jina (r.jina.ai): OLX_SCRAPE_DISABLE_JINA=1
# Limite de chamadas simultâneas à Jina (padrão: 2): OLX_SCRAPE_JINA_CONCURRENCY=2
# Retentativas Jina por anúncio (padrão: 3): OLX_SCRAPE_JINA_RETRIES=3
# Chave Jina (opcional, melhora rate limit): JINA_API_KEY="jina_..."
