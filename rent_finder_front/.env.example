# Copiar para .env.local na raiz do rent_finder_front.
# Sem DATABASE_URL, a home mostra instruções em vez de erro 500 opaco.

# --- Supabase self-hosted (Docker no mesmo servidor) — recomendado ---
# Após `npm run db:setup`, copie docker/supabase/.env.generated para aqui.
# Pooler transaction (6543); prepare: false já está no código.
# DATABASE_URL="postgresql://postgres.rentfinder:[POSTGRES_PASSWORD]@127.0.0.1:6543/postgres"

# --- Supabase Cloud (legado) ---
# DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
